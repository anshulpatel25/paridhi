# Paridhi Server Configuration
PARIDHI_SERVER_NAME=Paridhi
PARIDHI_SERVER_VERSION=0.1.0
PARIDHI_DEBUG=false
PARIDHI_LOG_LEVEL=INFO

# Spatial Radius Constraints (in meters)
PARIDHI_MIN_RADIUS_METERS=100.0
PARIDHI_MAX_RADIUS_METERS=50000.0
PARIDHI_DEFAULT_RADIUS_METERS=1000.0

# Query Result Limits
PARIDHI_DEFAULT_RESULTS_LIMIT=20
PARIDHI_MAX_RESULTS_LIMIT=100

# Transport Settings (stdio, http, sse)
PARIDHI_TRANSPORT=http
PARIDHI_HOST=0.0.0.0
PARIDHI_PORT=8000
PARIDHI_PATH=/mcp
