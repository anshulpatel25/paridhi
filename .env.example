# Paridhi Server Configuration
PARIDHI_SERVER_NAME=Paridhi
PARIDHI_SERVER_VERSION=0.1.0
PARIDHI_DEBUG=false
PARIDHI_LOG_LEVEL=INFO

# Geospatial Provider Configuration ('google', 'mock')
PARIDHI_SPATIAL_PROVIDER=google
GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere
# GOOGLE_API_KEY=AIzaSyYourGoogleMapsApiKeyHere

# Spatial Radius Constraints (in meters)
PARIDHI_MIN_RADIUS_METERS=100.0
PARIDHI_MAX_RADIUS_METERS=50000.0
PARIDHI_DEFAULT_RADIUS_METERS=1000.0

# Query Result Limits
PARIDHI_DEFAULT_RESULTS_LIMIT=20
PARIDHI_MAX_RESULTS_LIMIT=20

# Transport Settings (stdio, http, sse)
PARIDHI_TRANSPORT=http
PARIDHI_HOST=0.0.0.0
PARIDHI_PORT=8000
PARIDHI_PATH=/mcp

# OAuth 2.1 Authentication Settings (FastMCP built-in OAuth)
# Set PARIDHI_AUTH_ENABLED=true to protect HTTP/SSE transports with OAuth 2.1
PARIDHI_AUTH_ENABLED=false
PARIDHI_AUTH_PROVIDER=google
PARIDHI_AUTH_BASE_URL=http://localhost:8000
# PARIDHI_AUTH_REQUIRE_CONSENT=true
# JWT_SIGNING_KEY=your_random_32_byte_secret_key_here

# Google OAuth 2.0 IdP Credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Alternative IdPs (for future flexibility: GitHub, Keycloak, Auth0, Okta, etc.)
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret
# OIDC_CONFIG_URL=https://your-idp.example.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=your_oidc_client_id
# OIDC_CLIENT_SECRET=your_oidc_client_secret

